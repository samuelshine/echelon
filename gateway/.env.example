HTTP_ADDR=:8080
# Multi-Provider Configuration
PROVIDER_OPENAI_BASE_URL=https://api.openai.com
PROVIDER_OPENAI_API_KEY=
# PROVIDER_GEMINI_BASE_URL=https://generativelanguage.googleapis.com
# PROVIDER_GEMINI_API_KEY=
# PROVIDER_ANTHROPIC_BASE_URL=https://api.anthropic.com
# PROVIDER_ANTHROPIC_API_KEY=
# PROVIDER_OLLAMA_BASE_URL=http://host.docker.internal:11434
# PROVIDER_OLLAMA_API_KEY=

MODEL_ROUTES=
DEFAULT_PROVIDER=openai

MAX_REQUEST_BYTES=1048576
REQUEST_TIMEOUT=30s
UPSTREAM_TIMEOUT=20s
HTTP_READ_TIMEOUT=5s
HTTP_WRITE_TIMEOUT=35s
HTTP_IDLE_TIMEOUT=90s
SHUTDOWN_TIMEOUT=10s
SYSTEM_CANARY=[SYSTEM_CANARY_DEV]
LOG_LEVEL=info

# Cascade budgets and optional remote security services.
HEURISTIC_TIMEOUT=5ms
ML_TIMEOUT=150ms
JUDGE_TIMEOUT=800ms
EGRESS_TIMEOUT=250ms
ML_BASE_URL=
JUDGE_BASE_URL=
ML_JUDGE_THRESHOLD=0.55
ML_BLOCK_THRESHOLD=0.90
SECURITY_FAIL_CLOSED=true

# STREAM_FAST_MODE opts into genuine low-latency incremental streaming for
# stream:true clients. Off by default (buffered, fully-scanned, delivered as a
# single-chunk SSE response). When true, PII/policy are still enforced per chunk
# (one-chunk lag) but ML/judge egress detection becomes post-hoc — it can flag and
# log an already-delivered response but cannot block it. Real, documented tradeoff;
# see the "Streaming security modes" section in README.md before enabling.
STREAM_FAST_MODE=false

# RATE_LIMIT_BACKEND selects the rate limiter AND the credit ledger adapter
# together (one flag governs both distributed stores):
#   memory - in-process token bucket + credit ledger (default). No external deps;
#            state resets on restart and does not coordinate across processes.
#   redis  - Lua-script-atomic token bucket + credit ledger shared over REDIS_URL,
#            safe for multiple gateway replicas against one Redis instance.
# REDIS_URL is required when RATE_LIMIT_BACKEND=redis, e.g. redis://localhost:6379/0
# (or redis://redis:6379/0 under docker-compose, where a `redis` service is
# available for local/dev parity — see docker-compose.yml).
RATE_LIMIT_BACKEND=memory
REDIS_URL=
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_BURST=20
RATE_LIMIT_WINDOW=1m
RATE_LIMIT_KEY_PREFIX=echelon:rl:

# Observability (Phase 6). All optional; unset = today's behavior exactly.
#
# Shared durable Postgres (one instance backs THREE stores):
#   1. audit sink        — privacy-safe telemetry ring persisted to `prompt_events`,
#      hydrated from the most recent rows on startup (no empty console after a restart).
#   2. API-key store      — `api_keys`: keys created/re-limited/revoked from the console
#      survive restarts. When this is set, key auth is ENABLED even without
#      ECHELON_API_KEYS (from-zero bootstrap: create the first key from the console).
#   3. runtime-config      — `runtime_config`: ingress threshold + egress toggle overrides
#      set from the console are re-applied at boot so they survive a restart.
# Unset → all three degrade to in-memory only (no Postgres dependency to run the
# gateway); keys and config changes still work live but are lost on restart.
# Under docker-compose a `postgres` service is available for local/dev parity.
# AUDIT_DATABASE_URL=postgres://echelon:echelon@postgres:5432/echelon?sslmode=disable

# Prometheus metrics are always exposed (unauthenticated) at GET /metrics.
#
# OpenTelemetry tracing is configured entirely through the STANDARD OTel env vars
# (no gateway-specific names). With no OTLP endpoint set, tracing is a zero-cost
# no-op. Point it at any OTLP/HTTP collector to enable per-stage spans, e.g.:
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_SERVICE_NAME=echelon-gateway
# OTEL_EXPORTER_OTLP_HEADERS, OTEL_TRACES_SAMPLER, OTEL_RESOURCE_ATTRIBUTES, ... are also honored.
