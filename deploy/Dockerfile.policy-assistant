FROM python:3.13-slim

WORKDIR /app
COPY policy_assistant/requirements.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt
COPY policy_assistant ./policy_assistant

ENV PORT=8100 POLICY_DATA_DIR=/data
VOLUME ["/data"]
EXPOSE 8100

CMD ["sh", "-c", "gunicorn --workers 2 --threads 4 --bind 0.0.0.0:${PORT} --access-logfile - 'policy_assistant.app:create_app()'"]
