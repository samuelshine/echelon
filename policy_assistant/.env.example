# OpenAI or another OpenAI-compatible chat-completions provider.
# Leave blank to run the built-in extractive demo mode.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4.1-mini

# Service settings
HOST=0.0.0.0
PORT=8100
POLICY_DATA_DIR=./runtime
MAX_UPLOAD_BYTES=12582912
MAX_CONTEXT_CHUNKS=6
LLM_TIMEOUT_SECONDS=45
LLM_TEMPERATURE=0.1
