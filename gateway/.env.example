HTTP_ADDR=:8080
UPSTREAM_BASE_URL=https://api.openai.com
UPSTREAM_API_KEY=
MAX_REQUEST_BYTES=1048576
REQUEST_TIMEOUT=30s
UPSTREAM_TIMEOUT=20s
HTTP_READ_TIMEOUT=5s
HTTP_WRITE_TIMEOUT=35s
HTTP_IDLE_TIMEOUT=90s
SHUTDOWN_TIMEOUT=10s
SYSTEM_CANARY=[SYSTEM_CANARY_DEV]
LOG_LEVEL=info

# Cascade budgets and optional remote security services.
HEURISTIC_TIMEOUT=5ms
ML_TIMEOUT=150ms
JUDGE_TIMEOUT=800ms
EGRESS_TIMEOUT=250ms
ML_BASE_URL=
JUDGE_BASE_URL=
ML_JUDGE_THRESHOLD=0.55
ML_BLOCK_THRESHOLD=0.90
SECURITY_FAIL_CLOSED=true

# Use memory for one-process development. Redis support is introduced in Phase 4.
RATE_LIMIT_BACKEND=memory
REDIS_URL=
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_BURST=20
RATE_LIMIT_WINDOW=1m
RATE_LIMIT_KEY_PREFIX=echelon:rl:
