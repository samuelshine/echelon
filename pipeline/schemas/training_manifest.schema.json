{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Echelon reviewed training manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "eligible_for_training", "human_review_complete",
    "semantic_split_verified", "privacy_review_complete", "dataset_sha256",
    "rows", "splits"
  ],
  "properties": {
    "schema_version": {"type": "string", "minLength": 1},
    "eligible_for_training": {"const": true},
    "human_review_complete": {"const": true},
    "semantic_split_verified": {"const": true},
    "privacy_review_complete": {"const": true},
    "dataset_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "rows": {"type": "integer", "minimum": 1},
    "splits": {
      "type": "object",
      "required": ["train", "validation", "test"],
      "properties": {
        "train": {"type": "integer", "minimum": 1},
        "validation": {"type": "integer", "minimum": 1},
        "test": {"type": "integer", "minimum": 1}
      }
    }
  }
}
